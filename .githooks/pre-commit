#!/bin/sh
# Oraclous Knowledge Base pre-commit hook.
#
# When a commit touches a tracked .md file under a content section:
#   1. Regenerate root index.md + llms.txt (python3 required; warn-only if absent).
#   2. Refresh the graphify knowledge graph (graphify required; warn-only if absent).
#
# Both steps bundle the generated output into the same commit as the KB change so
# graphify-out/ never lags behind docs (ORAA-4 §16).
#
# Safe and fast: no network. Both generators fall back gracefully.
#
# Enable with: sh scripts/setup-hooks.sh   (sets core.hooksPath to .githooks)

set -e

# Content sections whose .md files drive index regeneration.
SECTIONS='adr architecture compliance contracts engineering flows frontend meta operations releases services-reference'

# Staged files in this commit (added/copied/modified/renamed).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# Does any staged file live under a content section AND end in .md?
needs_index=0
for f in $STAGED; do
	case "$f" in
		*.md)
			top=${f%%/*}
			for s in $SECTIONS; do
				if [ "$top" = "$s" ]; then
					needs_index=1
					break
				fi
			done
			;;
	esac
	[ "$needs_index" -eq 1 ] && break
done

if [ "$needs_index" -eq 0 ]; then
	exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
	echo "pre-commit: python3 not found; skipping KB index regeneration." >&2
	echo "pre-commit: run 'python3 scripts/build_kb_index.py' manually when available." >&2
	exit 0
fi

# Regenerate from the repo root so relative paths resolve.
REPO_ROOT=$(git rev-parse --show-toplevel)
python3 "$REPO_ROOT/scripts/build_kb_index.py" || {
	echo "pre-commit: KB index generation failed." >&2
	exit 1
}

# Stage the regenerated files so the commit carries a current index.
git add "$REPO_ROOT/index.md" "$REPO_ROOT/llms.txt"

# Refresh the knowledge graph (ORAA-4 §16).
# Bundles graphify-out/ into the same commit as the KB change — no separate
# "chore: refresh knowledge graph" commit needed.
# Decision (ORAA-210): manual step owned by docs-writer, automated here so it
# cannot be forgotten. Not a CI job: commit-back from CI is complex and the
# GitHub ruleset blocks it without a bypass token.
if command -v graphify >/dev/null 2>&1; then
	graphify update "$REPO_ROOT" || {
		echo "pre-commit: graphify update failed; knowledge graph may be stale." >&2
		echo "pre-commit: run 'sh scripts/refresh-graph.sh' manually to refresh." >&2
	}
	# Stage all graphify-out/ changes (no-op if nothing changed).
	git add "$REPO_ROOT/graphify-out/" 2>/dev/null || true
else
	echo "pre-commit: graphify not found; knowledge graph may be stale." >&2
	echo "pre-commit: install graphify or run 'sh scripts/refresh-graph.sh' manually." >&2
fi

exit 0
