<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fleet-keeper launchd agent (ORAA-250). Runs operations/fleet_keeper.py --apply every 600s.
     Install:  cp this to ~/Library/LaunchAgents/ then  launchctl load <path>
     Adjust ProgramArguments path + WorkingDirectory if the repo lives elsewhere. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oraclous.fleet-keeper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/reza/workspace/OraclousAI/oraclous-knowledge/operations/fleet_keeper.py</string>
        <string>--apply</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/reza/workspace/OraclousAI/oraclous-knowledge</string>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/fleet-keeper.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fleet-keeper.log</string>
</dict>
</plist>
